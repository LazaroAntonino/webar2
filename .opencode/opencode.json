{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/kimi-k2.7-code",
  "small_model": "opencode-go/kimi-k2.7-code",
  "default_agent": "build",
  "username": "Antony",
  "snapshot": true,
  "autoupdate": "notify",
  "share": "manual",
  "logLevel": "INFO",

  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*service-account*.json": "deny",
      "*credentials*.json": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny"
    },
    "edit": {
      "*": "allow",
      ".opencode/*": "ask",
      "*/.opencode/*": "ask",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*service-account*.json": "deny",
      "*credentials*.json": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      ".git/*": "deny",
      "*/.git/*": "deny",
      "node_modules/*": "deny",
      "*/node_modules/*": "deny",
      "dist/*": "deny",
      "*/dist/*": "deny"
    },
    "bash": {
      "*": "ask",
      "git status": "allow",
      "git status --short": "allow",
      "git diff --no-ext-diff": "allow",
      "git diff --no-ext-diff --stat": "allow",
      "git diff --no-ext-diff --check": "allow",
      "git diff --no-ext-diff --cached": "allow",
      "git log --oneline -10": "allow",
      "git ls-files": "allow",
      "npm run lint": "allow",
      "npm run build": "allow",
      "npm run audit": "allow",
      "node --check server/server.js": "allow",
      "node .opencode/scripts/validate.mjs": "allow",
      "node --test .opencode/tests/config.test.mjs": "allow",
      "git reset --hard*": "deny",
      "git clean -f*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny"
    },
    "task": {
      "*": "deny",
      "explore": "allow",
      "coder": "allow",
      "reviewer": "allow",
      "general": "ask"
    },
    "external_directory": "ask",
    "doom_loop": "ask",
    "question": "allow",
    "todowrite": "allow",
    "skill": "allow"
  },

  "formatter": false,

  "compaction": {
    "auto": true,
    "tail_turns": 5,
    "preserve_recent_tokens": 3000
  },

  "tool_output": {
    "max_lines": 500,
    "max_bytes": 102400
  },

  "instructions": [
    ".opencode/AGENTS.md"
  ]
}
